{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "REGEN DecisionEnvelope V0",
  "type": "object",
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "0"
    },
    "message_type": {
      "type": "string",
      "const": "DECISION"
    },
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_class": {
      "type": "string",
      "enum": [
        "CONTINUE_DETERMINISTIC",
        "INVESTIGATE_READ_ONLY",
        "REQUEST_CONTEXT",
        "REQUEST_CAPABILITY",
        "ESCALATE_HUMAN"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "rationale_summary": {
      "type": "string",
      "minLength": 1,
      "description": "Concise rationale grounded in observable evidence; not private chain-of-thought."
    },
    "requested_evidence": {
      "type": "array",
      "description": "Informational evidence descriptions only; these strings do not execute collection.",
      "items": {
        "type": "string"
      }
    },
    "requested_capabilities": {
      "type": "array",
      "description": "Typed caller actions. Non-terminal investigation, context, and capability-request decisions require at least one available entry under deterministic policy.",
      "items": {
        "type": "string"
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "label",
          "summary",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "resilience": {
      "type": "object",
      "properties": {
        "fallback_available": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "fallback_available",
        "summary"
      ],
      "additionalProperties": false
    },
    "requires": {
      "type": "object",
      "properties": {
        "mutation": {
          "type": "boolean"
        },
        "retry": {
          "type": "boolean"
        },
        "human": {
          "type": "boolean"
        }
      },
      "required": [
        "mutation",
        "retry",
        "human"
      ],
      "additionalProperties": false
    },
    "recommended_next_step": {
      "type": "string",
      "minLength": 1,
      "description": "A proposal for caller evaluation, never automatic execution."
    }
  },
  "required": [
    "protocol_version",
    "message_type",
    "incident_id",
    "decision_id",
    "decision_class",
    "summary",
    "rationale_summary",
    "requested_evidence",
    "requested_capabilities",
    "alternatives",
    "confidence",
    "resilience",
    "requires",
    "recommended_next_step"
  ],
  "additionalProperties": false
}
